{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "internet-sitesi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Yalnızca bu yollar Worker'dan geçer; CSS/JS gibi dosyalar doğrudan (ücretsiz ve sınırsız) sunulur
    "run_worker_first": ["/", "/index.html", "/api/*", "/ads.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // database_id yok: ilk yayında Cloudflare veritabanını otomatik oluşturur
      "database_name": "ucfiyat-db"
    }
  ],
  // schema.sql metin olarak içe aktarılır, tablolar ilk istekte otomatik kurulur
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
