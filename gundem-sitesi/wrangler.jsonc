{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Otomasyonun merkezi: gündem botu (zamanlanmış toplama + otomatik paylaşım) ve herkese açık haber sitesi.
  "name": "gundem-sitesi",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  // Yarım saatte bir toplar (ücretsiz planda Workers AI kotasına sığacak sıklık)
  // İkinci zamanlayıcı yalnızca haber görsellerini doldurur (src/worker.js GORSEL_CRON ile aynı olmalı)
  "triggers": { "crons": ["*/30 * * * *", "5,15,25,35,45,55 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "gundem-db", "database_id": "1a86cdff-48b3-4444-959d-fd0f6a900b92" }
  ],
  // Metin, çeviri ve görsel modelleri (ücretsiz katman: günde 10.000 nöron; varsayılan ayarlarla ~9.000)
  "ai": { "binding": "AI" },
  // Kısa haber videoları (src/video.js); Instagram videoyu /video/<id>.mp4 adresinden çeker. 48 saat sonra silinir.
  // GORSEL: haberlerin yapay zekâ görselleri (g/<id>.jpg), haberle birlikte 8 gün sonra kendiliğinden silinir
  "kv_namespaces": [
    { "binding": "VIDEO", "id": "6ca8f4d0d80844c7b4a268ffe3f193f9" },
    { "binding": "GORSEL", "id": "f1eb6002efbf41518f5830621b446b2b" }
  ],
  "vars": {
    // "0" yapılırsa platform bağlı olsa bile paylaşım durur
    "OTOMATIK_PAYLASIM": "1",
    "SITE_ADI": "Gündem Özeti",
    "SITE_ACIKLAMA": "Türkiye gündemindeki haberlerin kısa özetleri, her biri kaynağına bağlantılı."
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
